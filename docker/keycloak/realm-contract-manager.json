{
  "realm": "contract-manager",
  "enabled": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "ADMIN" },
      { "name": "CONTRACT_MANAGER" },
      { "name": "INSPECTOR" },
      { "name": "VIEWER" }
    ]
  },
  "clients": [
    {
      "clientId": "contract-manager-web",
      "name": "Contract Manager Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "person-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "person_id",
            "claim.name": "person_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "contract-manager-admin-api",
      "name": "Contract Manager Admin API",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "change-me-local-admin-api",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "service-account-contract-manager-admin-api",
      "enabled": true,
      "serviceAccountClientId": "contract-manager-admin-api",
      "clientRoles": {
        "realm-management": ["manage-users", "query-users", "view-users", "view-realm"]
      }
    }
  ]
}
