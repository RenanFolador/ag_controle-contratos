# PostgreSQL (desenvolvimento local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contract_manager
DB_USERNAME=contract_manager
DB_PASSWORD=change-me-local

# Backend
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=4200
BACKEND_URL=http://localhost:8080

# Autenticação Keycloak
KEYCLOAK_PORT=8081
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/contract-manager
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=contract-manager
KEYCLOAK_CLIENT_ID=contract-manager-web
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local

# Notificações (configuração futura)
NOTIFICATION_CRON=0 0 8 * * *
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=contracts@example.invalid
